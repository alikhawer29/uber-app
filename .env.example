NODE_ENV=development
PORT=3000
APP_NAME="NestJs App"

MONGODB_URI=mongodb://localhost:27017/file-management

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret
ZOOM_ACCOUNT_ID=your_zoom_account_id

# Zoho SMTP (use App Password if 2FA is on — https://accounts.zoho.com/home#security/app-passwords)
MAIL_HOST=smtppro.zoho.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-full-zoho-email@yourdomain.com
MAIL_PASSWORD=your-zoho-app-password
MAIL_FROM_ADDRESS=your-full-zoho-email@yourdomain.com
MAIL_FROM_NAME=Vilaire Valcin

# Copy the same MAIL_* block to the LIVE server .env (PM2 does not deploy .env from git)